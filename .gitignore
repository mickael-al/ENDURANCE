# Build products and IDE state
/Bin/
/build/
/out/
/.vs/
/.idea/
/CMakeUserPresets.json
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.log
__pycache__/
*.py[cod]

# Fallback location for locally compiled shader programs.
/Cache/ShaderPrograms/

# Steam redistributables are source dependencies, not local build products.
!/ThirdParty/steamworks_sdk/redistributable_bin/**/*.dll
!/ThirdParty/steamworks_sdk/redistributable_bin/**/*.so

# Local editor preferences and generated project settings
/ENDURANCE.editor.json
/ENDURANCE/Setting.json
/imgui.ini

# OBJ files are source meshes, so do not ignore *.obj globally.
