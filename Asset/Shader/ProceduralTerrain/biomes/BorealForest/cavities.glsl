float borealCavitySolidFraction(float height01)
{
    return clamp(mix(BOREAL_SOLID_BASE, BOREAL_SOLID_TOP,
        clamp(height01, 0.0, 1.0)), 0.0, 1.0);
}

float borealCavityThreshold(float voidFraction, float domainY)
{
    float index = clamp(voidFraction, 0.0, 1.0) * 20.0;
    int first = min(int(floor(index)), 19);
    float phase = abs(fract(domainY) - 0.5) * 64.0;
    int phaseFirst = min(int(floor(phase)), BOREAL_CAVITY_PHASE_INTERVALS - 1);
    int a = phaseFirst * 21 + first;
    int b = a + 21;
    float lower = mix(BOREAL_CAVITY_QUANTILES[a], BOREAL_CAVITY_QUANTILES[a + 1],
        index - float(first));
    float upper = mix(BOREAL_CAVITY_QUANTILES[b], BOREAL_CAVITY_QUANTILES[b + 1],
        index - float(first));
    return mix(lower, upper, phase - float(phaseFirst));
}

vec3 borealCavityCoordinates(vec3 p, uint seed)
{
    vec3 q = p / BOREAL_CAVITY_WARP_SCALE;
    // Three independently seeded 2D Perlins are injected into the 3D domain.
    // Y participates in two planes: this is a volumetric cavity field, not an
    // XZ mask extruded vertically. Keeping p/scale retains the world extent.
    vec3 warp = vec3(
        noisePerlin2D(q.yz, seed ^ 0xb74319dbu),
        noisePerlin2D(q.zx, seed ^ 0x5d2e8f61u),
        noisePerlin2D(q.xy, seed ^ 0x91ca723du));
    return p / BOREAL_CAVITY_SCALE + BOREAL_CAVITY_WARP_STRENGTH * warp;
}

float borealCavityNoise(vec3 p, uint seed)
{
    return noiseVoronoi3D01(borealCavityCoordinates(p, seed),
        seed ^ 0x39d7af25u);
}

// Positive stone, negative air. Distance-like units in world metres; the
// domain warp means this is not an exact signed distance for sphere tracing.
// The caller intersects excavation with the added mountain slab, protecting
// the unchanged soil below it. This helper has no terrain/biome dependency.
float borealCavityField(vec3 p, uint seed, float height01)
{
    // The caller passes the height over the COMPLETE mountain stack, not over
    // an individual 600-m layer. The gradient never restarts at a layer seam.
    vec3 domain = borealCavityCoordinates(p, seed);
    float threshold = borealCavityThreshold(1.0 - borealCavitySolidFraction(height01), domain.y);
    float noise = noiseVoronoi3D01(domain, seed ^ 0x39d7af25u);
    return (noise - threshold) * BOREAL_CAVITY_SCALE;
}

