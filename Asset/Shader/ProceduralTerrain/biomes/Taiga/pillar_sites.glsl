struct TaigaPillarSite
{
    vec2 center;  // foot center in world XZ, metres
    uint key;     // stable across query bins/chunks, varies across tiles/seeds
    float radius;
    float height; // requested vertical height, metres
    float tilt;   // radians, [0, pi/4]
    float azimuth;// radians, [0, 2*pi]
};

float taigaPillarRandom(uint key, uint salt)
{
    return noiseInternalUintTo01(noiseInternalHash(key ^ salt));
}

vec2 taigaPillarFrameAxis()
{
    return landSparseDirection(0x74616731u);
}

vec2 taigaPillarFrameOffset()
{
    return TAIGA_PILLAR_TILE_SIZE * vec2(
        taigaPillarRandom(uSeed, 0x27e7b92du),
        taigaPillarRandom(uSeed, 0x4d8b213fu));
}

vec2 taigaPillarLayout(vec2 worldXZ)
{
    vec2 axis = taigaPillarFrameAxis();
    return vec2(dot(worldXZ, axis), dot(worldXZ, vec2(-axis.y, axis.x)))
        + taigaPillarFrameOffset();
}

ivec2 taigaPillarGrid(vec2 worldXZ)
{
    return ivec2(floor(taigaPillarLayout(worldXZ) / TAIGA_PILLAR_BIN_SIZE));
}

ivec2 taigaPillarWrappedBin(ivec2 globalBin)
{
    // Avoid negative integer remainder operands (driver-dependent behavior).
    ivec2 remainder = abs(globalBin) % TAIGA_PILLAR_BINS_PER_SIDE;
    return ivec2(globalBin.x < 0 && remainder.x != 0
            ? TAIGA_PILLAR_BINS_PER_SIDE - remainder.x : remainder.x,
        globalBin.y < 0 && remainder.y != 0
            ? TAIGA_PILLAR_BINS_PER_SIDE - remainder.y : remainder.y);
}

uint taigaPillarBinRange(ivec2 globalBin)
{
    ivec2 bin = taigaPillarWrappedBin(globalBin);
    return TAIGA_PILLAR_BINS[bin.x + bin.y * TAIGA_PILLAR_BINS_PER_SIDE];
}

int taigaPillarBinCount(ivec2 globalBin)
{
    return int(taigaPillarBinRange(globalBin) >> 16u);
}

// Caller searches taigaPillarGrid(p) +/- 1 on both axes. This is conservative
// for any pillar contribution within 1600 m horizontally of its foot center.
// localIndex must be in [0, taigaPillarBinCount(globalBin)).
TaigaPillarSite taigaPillarInBin(ivec2 globalBin, int localIndex)
{
    uint index = (taigaPillarBinRange(globalBin) & 65535u) + uint(localIndex);
    uint packedPosition = TAIGA_PILLAR_POINTS[index];
    vec2 local = vec2(float(packedPosition & 65535u), float(packedPosition >> 16u))
        * (TAIGA_PILLAR_TILE_SIZE / 65536.0);
    ivec2 tile = (globalBin - taigaPillarWrappedBin(globalBin))
        / TAIGA_PILLAR_BINS_PER_SIDE;
    vec2 patternPosition = local + vec2(tile) * TAIGA_PILLAR_TILE_SIZE
        - taigaPillarFrameOffset();
    vec2 axis = taigaPillarFrameAxis();
    vec2 center = axis * patternPosition.x + vec2(-axis.y, axis.x) * patternPosition.y;
    uint key = noiseInternalHash(index * 0x9e3779b9u
        ^ uint(tile.x) * 0x85ebca6bu ^ uint(tile.y) * 0xc2b2ae35u
        ^ uSeed ^ 0x74616732u);
    return TaigaPillarSite(center, key,
        mix(100.0, 200.0, taigaPillarRandom(key, 0x1293a91du)),
        mix(500.0, 1000.0, taigaPillarRandom(key, 0x32da714bu)),
        0.7853981634 * taigaPillarRandom(key, 0x63f14729u),
        6.2831853072 * taigaPillarRandom(key, 0x817a329du));
}
