# Invoked before each executable build; Release must also clean stale dev files.
IF(NOT DEFINED OUTPUT_DIRECTORY OR OUTPUT_DIRECTORY STREQUAL "")
    MESSAGE(FATAL_ERROR "OUTPUT_DIRECTORY is required")
ENDIF()

SET(APP_ID_FILE "${OUTPUT_DIRECTORY}/steam_appid.txt")
IF(DEFINED LEGACY_APP_ID_FILE AND NOT LEGACY_APP_ID_FILE STREQUAL APP_ID_FILE)
    FILE(REMOVE "${LEGACY_APP_ID_FILE}")
ENDIF()

IF(DEPLOY_APP_ID AND BUILD_CONFIG MATCHES "^(Debug|RelWithDebInfo)$")
    IF(NOT STEAM_APP_ID MATCHES "^[0-9]+$" OR STEAM_APP_ID LESS 1)
        MESSAGE(FATAL_ERROR "STEAM_APP_ID must be a positive numeric AppID")
    ENDIF()
    FILE(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
    FILE(WRITE "${APP_ID_FILE}" "${STEAM_APP_ID}\n")
ELSE()
    FILE(REMOVE "${APP_ID_FILE}")
ENDIF()
